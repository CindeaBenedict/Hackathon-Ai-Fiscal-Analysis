# ─────────────────────────────────────────────────────────────
# Supply Chain Command Center — environment variables
# Copy this file to .env and fill in the keys you want to use.
# Docker Compose automatically loads .env from this directory.
# ─────────────────────────────────────────────────────────────

# ── AI providers (all optional) ──────────────────────────────

# Anthropic Claude — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI GPT — get a key at https://platform.openai.com
OPENAI_API_KEY=

# ── Ollama default model ──────────────────────────────────────
# This model is downloaded automatically on first start (~1 GB).
# Other popular options: llama3, mistral, qwen2.5:3b
DEFAULT_MODEL=llama3.2:1b
