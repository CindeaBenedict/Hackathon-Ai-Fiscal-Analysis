# Production build (Vercel / Docker nginx)
# Leave VITE_API_BASE_URL blank → defaults to /api in the code.
# Vercel: set the real backend URL in Vercel Dashboard → Settings → Environment Variables:
#   VITE_API_BASE_URL = https://your-backend.railway.app
# Docker: nginx proxies /api → backend container, so no change needed.
VITE_API_BASE_URL=
